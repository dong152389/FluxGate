# 服务监听端口
PORT=80

# 数据加密密钥（请修改为随机复杂字符串，用于安全加密存储订阅等信息）
APP_SECRET=change-this-secret-before-deploy

# 对外访问地址（用于生成公开订阅链接，填入你的公网 IP 或域名，不要带末尾斜杠）
PUBLIC_BASE_URL=http://localhost:80

# MySQL 数据库配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=fluxgate
MYSQL_PASSWORD=fluxgate_password
MYSQL_DATABASE=fluxgate
# 或者直接提供完整连接串：
# MYSQL_URL=mysql://fluxgate:fluxgate_password@mysql:3306/fluxgate

# 会话与缓存配置
SESSION_TTL_DAYS=30
CACHE_TTL_SECONDS=600

# 邮件服务配置（可选，如需注册验证码功能可配置）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=FluxGate <no-reply@example.com>
# EMAIL_WHITELIST=
