/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fluxgate-sub-aggregator",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-19",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/sub/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fluxgate-db",
			"database_id": "f7a0802d-37ff-44cd-b0f3-a7bbeee1a05c",
			"preview_database_id": "f7a0802d-37ff-44cd-b0f3-a7bbeee1a05c",
			"migrations_dir": "./migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "691de0008987429387d01df7ebead152",
			"preview_id": "91d1ae14c42e44f0865f4c803d78eee7"
		}
	],
	"vars": {
		"APP_NAME": "FluxGate",
		"SESSION_TTL_DAYS": "30",
		"CACHE_TTL_SECONDS": "600"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
